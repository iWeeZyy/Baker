# MongoDB connection string and database name.
# Local dev: run `docker run -d -p 27017:27017 mongo:7` and use the URL below.
# Production: use a MongoDB Atlas connection string.
MONGO_URL=mongodb://localhost:27017
DB_NAME=bakers

# Secret used to sign JWT auth tokens. Generate your own with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Never reuse this example value and never commit your real secret.
JWT_SECRET=changeme-generate-a-real-secret

# Anthropic API key for the AI baking assistant (console.anthropic.com).
# Leave empty to disable the /api/chat endpoint (it returns 503 without it).
ANTHROPIC_API_KEY=

# Pexels API key, used ONLY by tools/harvest_pexels.py to collect recipe photos
# (https://www.pexels.com/api/, free). The running server never calls Pexels:
# photos are picked once at harvest time and written into recipe_photos.py.
# Harvesting also needs api.pexels.com and images.pexels.com reachable.
PEXELS_API_KEY=

# Comma-separated list of allowed frontend origins for CORS.
# Use "*" only for local development.
CORS_ORIGINS=*

# --- Message photo moderation -------------------------------------------------
# A photo sent in a conversation is analyzed by Sightengine (nudity detection,
# https://sightengine.com — free tier, sign up for an API user/secret) before
# being stored. A "sensitive" result never blocks the send: the photo is sent
# blurred behind a warning until the recipient chooses to reveal it. Only a
# "blocked" (unambiguously explicit) result is refused outright. See
# backend/moderation.py for the full rationale and backend/CLAUDE.md.
#
# Leave both empty to run without real moderation: every photo then falls
# back to MODERATION_FALLBACK below (default "sensitive") rather than being
# treated as safe — the feature stays deploy-safe without a key, just always
# cautious. Harvesting also needs api.sightengine.com reachable.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# "sightengine" (default, real calls) | "stub" (deterministic, network-free —
# test suite / local dev ONLY, never set this in production) | "off"
# (moderation disabled, every photo falls back — for local dev without an
# internet connection).
MODERATION_PROVIDER=sightengine

# Sightengine's explicit-content score (0..1) that flips a photo from
# normal -> sensitive (blurred + warning) and from sensitive -> blocked
# (refused outright). Retune here without a rebuild.
MODERATION_SENSITIVE_THRESHOLD=0.30
MODERATION_BLOCK_THRESHOLD=0.90

# Level assigned when the provider is unreachable, unconfigured, or errors.
# "sensitive" | "blocked" | "normal" — default is deliberately never "normal".
MODERATION_FALLBACK=sensitive

# Comma-separated emails granted Baker Pro. There is no billing provider yet,
# so this is how a Pro account is created. Server-side, so it cannot be forged.
PRO_EMAILS=

# --- Advertising -------------------------------------------------------------
# Master switch, OFF by default and deliberately so: turning ads on while Baker
# Pro cannot be purchased would impose them on every user with no way out.
# Only flip this to true once an in-app purchase exists AND a consent flow
# (Google UMP + iOS ATT) is wired into frontend/src/ads/provider.ts.
ADS_ENABLED=false

# Which network the app should use once one is integrated (e.g. "admob").
ADS_NETWORK=

# How often an ad appears in the recipe list: first slot after N cards, then
# one every M. Tunable here so the frequency can change without an app release.
ADS_LIST_FIRST_SLOT=6
ADS_LIST_INTERVAL=10
