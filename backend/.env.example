# MongoDB connection string and database name.
# Local dev: run `docker run -d -p 27017:27017 mongo:7` and use the URL below.
# Production: use a MongoDB Atlas connection string.
MONGO_URL=mongodb://localhost:27017
DB_NAME=bakers

# Secret used to sign JWT auth tokens. Generate your own with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Never reuse this example value and never commit your real secret.
JWT_SECRET=changeme-generate-a-real-secret

# Anthropic API key for the AI baking assistant (console.anthropic.com).
# Leave empty to disable the /api/chat endpoint (it returns 503 without it).
ANTHROPIC_API_KEY=

# Comma-separated list of allowed frontend origins for CORS.
# Use "*" only for local development.
CORS_ORIGINS=*
