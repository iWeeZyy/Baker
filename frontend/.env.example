# Base URL of your backend API (no trailing slash, no /api suffix).
# Local dev, physical device on the same Wi-Fi: use your computer's LAN IP, e.g. http://192.168.1.10:8000
# Local dev, iOS simulator: http://localhost:8000 works fine.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# AdMob (see src/ads/, app.config.js). Free-plan accounts only — Pro never
# sees an ad, enforced server-side (backend/plans.py::ads_allowed).
# Leave every one of these unset to use Google's public test IDs (always
# fill, never real revenue, safe for local dev) — that's the default in
# app.config.js. Only set these once Lucas has a real AdMob account and app.
# EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
# EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
# EXPO_PUBLIC_ADMOB_IOS_BANNER_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
# EXPO_PUBLIC_ADMOB_ANDROID_BANNER_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
# Interstitial/rewarded: not called from any screen yet (see src/ads/interstitial.ts,
# src/ads/rewarded.ts) — unit IDs read here so a unit is ready once wired.
# EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
# EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
# EXPO_PUBLIC_ADMOB_IOS_REWARDED_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
# EXPO_PUBLIC_ADMOB_ANDROID_REWARDED_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
